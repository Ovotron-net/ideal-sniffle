# ── MSW mode (default) ──────────────────────────────────────
# Vite dev server with MSW intercepting API calls
VITE_USE_MSW=true
VITE_API_URL=/api/v1

# ── Local API server mode ───────────────────────────────────
# Run: npm run dev:full
# VITE_USE_MSW=false
# VITE_API_URL=/api/v1

# ── SEO ─────────────────────────────────────────────────────
VITE_SITE_URL=https://nexusguard.io

# ── Remote backend ──────────────────────────────────────────
# Point at your deployed API (must implement openapi/nexusguard.openapi.yaml)
# VITE_USE_MSW=false
# VITE_API_URL=https://api.nexusguard.io/api/v1