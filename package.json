{
  "name": "ovotron",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:seo && vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently -n api,vite -c blue,green \"npm run dev:api\" \"vite --mode local.api\"",
    "build": "npm run generate:api && npm run generate:seo -- production && tsc -b && vite build",
    "generate:seo": "tsx scripts/generate-seo-static.ts",
    "check": "npm run lint && npm run test && npm run build",
    "generate:api": "orval --config orval.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": "vitest run server/api.test.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.5.0",
    "@hono/node-server": "^1.19.11",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/router-devtools": "^1.167.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "hono": "^4.12.7",
    "msw": "^2.14.6",
    "orval": "^8.19.0",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
